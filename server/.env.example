# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas cluster credentials
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/retroflow?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/retroflow?retryWrites=true&w=majority

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# Brevo (Sendinblue) Transactional Email API (HTTPS Port 443)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME=RetroFlow
